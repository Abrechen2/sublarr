# Bot token — SECRET. Source of truth: Infisical project `sublarr`,
# environment `prod`, key DISCORD_BOT_TOKEN. Never commit the real value.
DISCORD_BOT_TOKEN=

# Guild (server) id — NOT a secret: it appears in every invite link and
# cannot be rotated, so it stays here in git rather than in Infisical.
DISCORD_GUILD_ID=1494956122606407680

# --- Optional social targets for `announce --targets mastodon,bluesky` ---
# All SECRET except the instance URL / handle. Never commit real values.
# Mastodon: access token of an app with the write:statuses scope.
MASTODON_INSTANCE=
MASTODON_ACCESS_TOKEN=
# Bluesky: use an APP PASSWORD (Settings -> Privacy and security), never the
# account password. BLUESKY_SERVICE is optional (default https://bsky.social).
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
# BLUESKY_SERVICE=
